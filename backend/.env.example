# Copia este archivo a backend\.env y completa los valores. NUNCA subas .env ni pongas secretos aqui.
# Token de @BotFather (bot NUEVO; revoca cualquier token que haya sido expuesto)
TELEGRAM_BOT_TOKEN=
# API key de Groq: https://console.groq.com
GROQ_API_KEY=
# Modelo: se elige con `python -m app.llm.list_models` (lista real de tu cuenta)
GROQ_MODEL=
# Proveedor activo (por ahora solo groq)
LLM_PROVIDER=groq
LOG_LEVEL=INFO
