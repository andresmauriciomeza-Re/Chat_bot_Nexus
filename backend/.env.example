# Copia este archivo a backend\.env y completa los valores. NUNCA subas .env ni pongas secretos aqui.
# Token de @BotFather (bot NUEVO; revoca cualquier token que haya sido expuesto)
TELEGRAM_BOT_TOKEN=
# API key de Groq: https://console.groq.com
GROQ_API_KEY=
# Modelo: se elige con `python -m app.llm.list_models` (lista real de tu cuenta)
GROQ_MODEL=
# Proveedor activo (por ahora solo groq)
LLM_PROVIDER=groq
LOG_LEVEL=INFO
# --- Fase 1: videojuegos (todos opcionales; valores por defecto en config.py) ---
GAMES_ENABLED=true
CHEAPSHARK_ENABLED=true
STEAM_ENABLED=true
EPIC_ENABLED=true
TRM_ENABLED=true
BUDGET_SANITY_MAX_COP=1000000
BUDGET_SANITY_MAX_USD=300
GROQ_BUDGET_ENABLED=true
GROQ_DAILY_TOKEN_BUDGET=160000
GROQ_USER_DAILY_TOKENS=20000
DATA_DIR=data
# --- Fase 2: riesgo y robustez ---
RISK_GUARD_ENABLED=true
LOG_TO_FILE=false
LOG_DIR=logs
# --- Fase 3: diseno e interaccion ---
MAIN_PANEL_ENABLED=true
MAIN_KEYBOARD_ENABLED=true
MASCOT_ANIM_ENABLED=true
WELCOME_ANIM_ENABLED=true
CARDS_ENABLED=true
